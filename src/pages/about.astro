---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Nanda R - NandLabs" description="I'm Nanda R, a software engineer with over 20 years of experience. This is my personal space for thoughts, projects, and links.">
  <section class="about-hero shell">
    <div class="portrait-frame">
      <img src="/images/nanda.jpg" width="420" height="420" alt="Nanda Raghunathan" />
    </div>
    <div>
      <p class="eyebrow">About</p>
      <h1>I'm Nanda R.</h1>
      <p class="hero-dek">I'm a software engineer with over 20 years of experience.</p>
      <div class="prose compact">
        <p>This is my personal space to share thoughts, projects I'm working on, and articles, papers, and blogs that I find interesting.</p>
        <p>I'll try to keep the posts short and write once a week.</p>
        <p>If something caught your eye, <a href="mailto:nanda@thenandlabs.com">email me</a> or <a href="https://calendly.com/nanda-thenandlabs/30min">book time to talk</a>.</p>
      </div>
      <div class="hero-actions">
        <a class="button" href="https://www.linkedin.com/in/nandaraghunathan">LinkedIn</a>
        <a class="text-link" href="/writing">Read my writing <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
