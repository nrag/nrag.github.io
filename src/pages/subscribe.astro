---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout title="Subscribe — NandLabs" description="Subscribe to occasional essays and notes from NandLabs.">
  <header class="page-header shell-narrow">
    <p class="eyebrow">Stay in the loop</p>
    <h1>One thoughtful note at a time.</h1>
    <p>Subscribe for new essays, technical notes, worthwhile links, and the occasional business idea. No fixed cadence and no manufactured urgency.</p>
  </header>
  <div class="section shell"><Newsletter /></div>
</BaseLayout>
