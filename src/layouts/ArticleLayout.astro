---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  kind: string;
  topics: string[];
}

const { title, description, publishedAt, updatedAt, kind, topics } = Astro.props;
---

<BaseLayout title={`${title} — NandLabs`} description={description} image={null} article>
  <article class="article shell-narrow">
    <header class="article-header">
      <a class="back-link" href="/writing">← All writing</a>
      <div class="writing-meta">
        <span class={`kind kind-${kind}`}>{kind}</span>
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
        </time>
      </div>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>
      <p class="article-byline">
        By Nanda Raghunathan
        {updatedAt && <> · Updated <time datetime={updatedAt.toISOString()}>{updatedAt.toLocaleDateString('en-US', { timeZone: 'UTC' })}</time></>}
      </p>
      <div class="topic-list" aria-label="Topics">{topics.map((topic) => <span>{topic}</span>)}</div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
