---
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME?.trim();
interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div>
    <Heading id="newsletter-title">Subscribe</Heading>
    <p>New posts by email. About once a week.</p>
  </div>
  {username ? (
  <form
    class="subscribe-form"
    action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
    method="post"
  >
    <label for="bd-email">Email address</label>
    <div class="form-row">
      <input id="bd-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
      <button class="button" type="submit">Subscribe</button>
    </div>
    <p class="form-note">You can also follow through <a href="/rss.xml">RSS</a>. Unsubscribe anytime.</p>
  </form>
  ) : (
    <div>
      <p>Email signup is coming soon. <a href="/rss.xml">Follow via RSS</a> for now.</p>
    </div>
  )}
</section>
