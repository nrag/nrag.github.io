{
  "name": "thenandlabs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check": "npm run check:astro && npm run check:content",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:content": "node scripts/check-content.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.mjs",
    "test:a11y": "npm run build && playwright test tests/a11y",
    "test:site": "npm run build && playwright test tests/site"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
